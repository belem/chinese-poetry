[
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "天地玄黃，宇宙洪荒。"
        ],
        "id": "132eb8"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "日月盈昃，辰宿列張。"
        ],
        "id": "6ikb3d"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "寒來暑往，秋收冬藏。"
        ],
        "id": "lj5238"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "閏餘成歲，律呂調陽。"
        ],
        "id": "f1ifik"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "雲騰致雨，露結為霜。"
        ],
        "id": "9l34df"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "金生麗水，玉出崑岡。"
        ],
        "id": "30fdc6"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "劍號巨闕，珠稱夜光。"
        ],
        "id": "8a94i8"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "果珍李柰，菜重芥薑。"
        ],
        "id": "39flj8"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "海鹹河淡，鱗潛羽翔。"
        ],
        "id": "b09986"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "龍師火帝，鳥官人皇。"
        ],
        "id": "k0c9i4"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "始制文字，乃服衣裳。"
        ],
        "id": "eahie3"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "推位讓國，有虞陶唐。"
        ],
        "id": "43fdi7"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "弔民伐罪，周發殷湯。"
        ],
        "id": "7g73di"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "坐朝問道，垂拱平章。"
        ],
        "id": "jdil6g"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "愛育黎首，臣伏戎羌。"
        ],
        "id": "l1a4e7"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "遐邇壹體，率賓歸王。"
        ],
        "id": "9cg50j"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "鳴鳳在樹，白駒食場。"
        ],
        "id": "13j40i"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "化被草木，賴及萬方。"
        ],
        "id": "i5h5ib"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "蓋此身髮，四大五常。"
        ],
        "id": "3j99g8"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "恭惟鞠養，豈敢毀傷。"
        ],
        "id": "8j24jj"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "女慕貞絜，男效才良。"
        ],
        "id": "2k56aj"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "知過必改，得能莫忘。"
        ],
        "id": "1i0c6c"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "罔談彼短，靡恃己長。"
        ],
        "id": "97a5hi"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "信使可覆，器欲難量。"
        ],
        "id": "60l30b"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "墨悲絲染，詩讚羔羊。"
        ],
        "id": "9234l2"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "景行維賢，克念作聖。"
        ],
        "id": "kd0h43"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "德建名立，形端表正。"
        ],
        "id": "f11fll"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "空谷傳聲，虛堂習聽。"
        ],
        "id": "1f6g26"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "禍因惡積，福緣善慶。"
        ],
        "id": "2db109"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "尺璧非寶，寸陰是競。"
        ],
        "id": "hd9l57"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "資父事君，曰嚴與敬。"
        ],
        "id": "fek943"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "孝當竭力，忠則盡命。"
        ],
        "id": "77gdj6"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "臨深履薄，夙興溫凊。"
        ],
        "id": "3j7ikf"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "似蘭斯馨，如松之盛。"
        ],
        "id": "ddc2ji"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "川流不息，淵澄取映。"
        ],
        "id": "2j6ljl"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "容止若思，言辭安定。"
        ],
        "id": "hbc9c7"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "篤初誠美，慎終宜令。"
        ],
        "id": "1c63ik"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "榮業所基，籍甚無竟。"
        ],
        "id": "d37ckk"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "學優登仕，攝職從政。"
        ],
        "id": "kbg02a"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "存以甘棠，去而益詠。"
        ],
        "id": "akhf66"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "樂殊貴賤，禮別尊卑。"
        ],
        "id": "g7j0gl"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "上和下睦，夫唱婦隨。"
        ],
        "id": "j26k16"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "外受傅訓，入奉母儀。"
        ],
        "id": "cd3f5d"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "諸姑伯叔，猶子比兒。"
        ],
        "id": "h40e43"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "孔懷兄弟，同氣連枝。"
        ],
        "id": "5ac3ll"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "交友投分，切磨箴規。"
        ],
        "id": "4k04f2"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "仁慈隱惻，造次弗離。"
        ],
        "id": "fa51bd"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "節義廉退，顛沛匪虧。"
        ],
        "id": "26he64"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "性靜情逸，心動神疲。"
        ],
        "id": "3ee4eh"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "守真志滿，逐物意移。"
        ],
        "id": "26h12c"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "堅持雅操，好爵自縻。"
        ],
        "id": "hi15k2"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "都邑華夏，東西二京。"
        ],
        "id": "b767hc"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "背邙面洛，浮渭據涇。"
        ],
        "id": "b1kfe0"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "宮殿盤鬱，樓觀飛驚。"
        ],
        "id": "bl809c"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "圖寫禽獸，畫綵仙靈。"
        ],
        "id": "37d79l"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "丙舍傍啓，甲帳對楹。"
        ],
        "id": "1faei7"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "肆筵設席，鼓瑟吹笙。"
        ],
        "id": "l7h2ke"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "升階納陛，弁轉疑星。"
        ],
        "id": "1c7714"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "右通廣內，左達承明。"
        ],
        "id": "1egl94"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "既集墳典，亦聚群英。"
        ],
        "id": "ljdifd"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "杜稾鍾隸，漆書壁經。"
        ],
        "id": "3948fc"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "府羅將相，路俠槐卿。"
        ],
        "id": "90g738"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "戶封八縣，家給千兵。"
        ],
        "id": "8h92i6"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "高冠陪輦，驅轂振纓。"
        ],
        "id": "6f1a5e"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "世祿侈富，車駕肥輕。"
        ],
        "id": "256bfk"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "策功茂實，勒碑刻銘。"
        ],
        "id": "hce35j"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "磻溪伊尹，佐時阿衡。"
        ],
        "id": "3i319k"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "奄宅曲阜，微旦孰營。"
        ],
        "id": "24ke1b"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "桓公匡合，濟弱扶傾。"
        ],
        "id": "gehdki"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "綺迴漢惠，說感武丁。"
        ],
        "id": "2dbdel"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "俊乂密勿，多士寔寧。"
        ],
        "id": "767d49"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "晉楚更霸，趙魏困橫。"
        ],
        "id": "h590g2"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "假途滅虢，踐土會盟。"
        ],
        "id": "c4jik0"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "何遵約法，韓弊煩刑。"
        ],
        "id": "fcg321"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "起翦頗牧，用軍最精。"
        ],
        "id": "79da12"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "宣威沙漠，馳譽丹青。"
        ],
        "id": "597321"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "九州禹跡，百郡秦并。"
        ],
        "id": "78ai0i"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "嶽宗恆岱，禪主云亭。"
        ],
        "id": "18h40e"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "雁門紫塞，雞田赤城。"
        ],
        "id": "ji5a32"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "昆池碣石，鉅野洞庭。"
        ],
        "id": "h3elh5"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "曠遠綿邈，巖岫杳冥。"
        ],
        "id": "c16ega"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "治本於農，務茲稼穡。"
        ],
        "id": "221h9l"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "俶載南畝，我藝黍稷。"
        ],
        "id": "l79b1f"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "稅熟貢新，勸賞黜陟。"
        ],
        "id": "f393fk"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "孟軻敦素，史魚秉直。"
        ],
        "id": "886hdf"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "庶幾中庸，勞謙謹敕。"
        ],
        "id": "fjkcdf"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "聆音察理，鑒貌辨色。"
        ],
        "id": "djja58"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "貽厥嘉猷，勉其祗植。"
        ],
        "id": "3k6729"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "省躬譏誡，寵增抗極。"
        ],
        "id": "13kc7c"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "殆辱近恥，林皋幸即。"
        ],
        "id": "bkj78k"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "兩疏見機，解組誰逼。"
        ],
        "id": "e2f86b"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "索居閑處，沈默寂寥。"
        ],
        "id": "2c2f4l"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "求古尋論，散慮逍遙。"
        ],
        "id": "la53eg"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "欣奏累遣，慼謝歡招。"
        ],
        "id": "9adld6"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "渠荷的歷，園莽抽條。"
        ],
        "id": "279d22"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "枇杷晚翠，梧桐早凋。"
        ],
        "id": "3b78jl"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "陳根委翳，落葉飄颻。"
        ],
        "id": "cl0gah"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "遊鶤獨運，淩摩絳霄。"
        ],
        "id": "eeag71"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "耽讀翫市，寓目囊箱。"
        ],
        "id": "8bca89"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "易輶攸畏，屬耳垣牆。"
        ],
        "id": "gh5f1l"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "具膳餐飯，適口充腸。"
        ],
        "id": "c0kdld"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "飽飫烹宰，飢厭糟糠。"
        ],
        "id": "252cai"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "親戚故舊，老少異糧。"
        ],
        "id": "j6icaa"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "妾御績紡，侍巾帷房。"
        ],
        "id": "5f6ic8"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "紈扇圓潔，銀燭煒煌。"
        ],
        "id": "8ja570"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "晝眠夕寐，藍筍象牀。"
        ],
        "id": "b6c2gb"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "弦歌酒讌，接杯舉觴。"
        ],
        "id": "28973a"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "矯手頓足，悅豫且康。"
        ],
        "id": "jl0bg7"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "嫡後嗣續，祭祀烝嘗。"
        ],
        "id": "41gh0i"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "稽顙再拜，悚懼恐惶。"
        ],
        "id": "154jcl"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "牋牒簡要，顧答審詳。"
        ],
        "id": "d637ib"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "骸垢想浴，執熱願涼。"
        ],
        "id": "90jlia"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "驢騾犢特，駭躍超驤。"
        ],
        "id": "g18hk8"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "誅斬賊盜，捕獲叛亡。"
        ],
        "id": "010d61"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "布射僚丸，嵇琴阮嘯。"
        ],
        "id": "ij5lk6"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "恬筆倫紙，鈞巧任釣。"
        ],
        "id": "170h8f"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "釋紛利俗，並皆佳妙。"
        ],
        "id": "2ddhkg"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "毛施淑姿，工顰妍笑。"
        ],
        "id": "9dd81e"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "年矢每催，曦暉朗曜。"
        ],
        "id": "71k8ag"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "璇璣懸斡，晦魄環照。"
        ],
        "id": "5gjffk"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "指薪修祜，永綏吉劭。"
        ],
        "id": "80b0gk"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "矩步引領，俯仰廊廟。"
        ],
        "id": "fif4le"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "束帶矜莊，徘徊瞻眺。"
        ],
        "id": "231b32"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "孤陋寡聞，愚蒙等誚。"
        ],
        "id": "6i91a6"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [
            "謂語助者，焉哉乎也。"
        ],
        "id": "dkdlek"
    },
    {
        "title": "千字文",
        "author": "周興嗣",
        "dynasty": "南北朝",
        "paragraphs": [],
        "variants": [
            {
                "chapter": "正文",
                "line": "閏餘成歲，律呂調陽。",
                "note": "唐人作「律召調陽」"
            },
            {
                "chapter": "正文",
                "line": "金生麗水，玉出崑岡。",
                "note": "崑岡，又作「昆岡」、「崐岡」、「崑崗」"
            },
            {
                "chapter": "正文",
                "line": "鳴鳳在樹，白駒食場。",
                "note": "一作「鳴鳳在竹」"
            },
            {
                "chapter": "正文",
                "line": "景行維賢，克念作聖。",
                "note": "克，又作「剋」"
            },
            {
                "chapter": "正文",
                "line": "圖寫禽獸，畫綵仙靈。",
                "note": "綵，又作「采」、「彩」。仙，又作「僊」"
            },
            {
                "chapter": "正文",
                "line": "升階納陛，弁轉疑星。",
                "note": "升，又作「昇」"
            },
            {
                "chapter": "正文",
                "line": "嶽宗恆岱，禪主云亭。",
                "note": "一作「嶽宗泰岱」"
            },
            {
                "chapter": "正文",
                "line": "雁門紫塞，雞田赤城。",
                "note": "雁，又作「鴈」"
            },
            {
                "chapter": "正文",
                "line": "聆音察理，鑒貌辨色。",
                "note": "鑒，又作「鑑」。貌，又作「皃」"
            },
            {
                "chapter": "正文",
                "line": "枇杷晚翠，梧桐早凋。",
                "note": "凋，又作「彫」"
            },
            {
                "chapter": "正文",
                "line": "紈扇圓潔，銀燭煒煌。",
                "note": "圓，又作「員」"
            },
            {
                "chapter": "正文",
                "line": "弦歌酒讌，接杯舉觴。",
                "note": "弦，又作「絃」。讌，又作「醼」、「燕」"
            },
            {
                "chapter": "正文",
                "line": "嫡後嗣續，祭祀烝嘗。",
                "note": "烝，又作「蒸」"
            },
            {
                "chapter": "正文",
                "line": "毛施淑姿，工顰妍笑。",
                "note": "顰，又作「嚬」、「頻」。笑，又作「咲」"
            },
            {
                "chapter": "正文",
                "line": "璇璣懸斡，晦魄環照。",
                "note": "璇，又作「琁」、「璿」"
            },
            {
                "chapter": "正文",
                "line": "指薪修祜，永綏吉劭。",
                "note": "修，又作「脩」"
            },
            {
                "chapter": "正文",
                "line": "束帶矜莊，徘徊瞻眺。",
                "note": "徘徊，又作「俳佪」、「裴回」"
            }
        ],
        "id": "7ke41k"
    }
]
