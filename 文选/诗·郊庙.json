[
  {
    "author": "顏延年",
    "paragraphs": [
      "夤威寶命，嚴恭帝祖。",
      "炳海表岱，系唐胄楚。",
      "靈監叡文，民屬叡武。",
      "奄受敷錫，宅中拓宇。",
      "亙地稱皇，罄天作主。",
      "月竁來賓，日際奉土。",
      "開元首正，禮交樂舉。",
      "六典聯事，九官列序。",
      "有牷在滌，有絜在俎。",
      "薦饗王衷，以答神祜。",
      "維聖饗帝，維孝饗親。",
      "皇乎備矣，有事上春。",
      "禮行宗祀，敬達郊禋。",
      "金枝中樹，廣樂四陳。",
      "陟配在京，降德在民。",
      "奔精昭夜，高燎煬晨。",
      "陰明浮爍，沈禜深淪。",
      "告成大報，受釐元神。",
      "月御案節，星驅扶輪。",
      "遙興遠駕，曜曜振振。"
    ],
    "title": "宋郊祀歌二首"
  }
]
