[
  {
    "author": "班孟堅",
    "paragraphs": [
      "皇矣漢祖，纂堯之緒。",
      "寔天生德，聰明神武。",
      "秦人不綱，網漏於楚。",
      "爰茲發跡，斷蛇奮旅。神母告符，朱旗乃舉。",
      "粵蹈秦郊，嬰來稽首。",
      "革命創制，三章是紀。",
      "應天順民，五星同晷。",
      "項氏畔換，黜我巴漢，",
      "西土宅心，戰士憤怨。",
      "乘舋而運，席捲三秦。",
      "割據河山，保此懷民。",
      "股肱蕭曹，社稷是經。",
      "爪牙信布，腹心良平，",
      "恭行天罰，赫赫明明。",
      "述高紀第一",
      "孝成皇皇，臨朝有光。",
      "威儀之盛，如珪如璋。",
      "閫闈恣趙，朝政在王。",
      "炎炎燎火，亦允不陽。",
      "述成紀第十",
      "信惟餓隸，布實黥徒。",
      "越亦狗盜，芮尹江湖。",
      "雲起龍驤，化為侯王。割有齊楚，跨制淮梁。",
      "綰自同閈，鎮我北疆。",
      "德薄位尊，非祚惟殃。",
      "吳克忠信，胤嗣乃長。",
      "述韓英彭盧吳傳第四"
    ],
    "title": "史述贊三首"
  },
  {
    "author": "範蔚宗",
    "paragraphs": [
      "贊曰：炎政中微，大盜移國。",
      "九縣飆回，三精霧塞。",
      "民厭淫詐，神思反德。世祖誕命，靈貺自甄。",
      "沈機先物，深略緯天。",
      "尋邑百萬，貔虎為群。長轂雷野，高旗彗雲。",
      "英威既振，新都自焚。",
      "虔劉庸代。紛紜梁趙。",
      "三河未澄，四關重擾。",
      "神旌乃顧，遞行天討。金湯失險，車書共道。",
      "靈慶既啟，人謀鹹贊。",
      "明明廟謀，赳赳雄斷。",
      "於赫有命，系我皇漢。"
    ],
    "title": "後漢書光武紀贊"
  }
]
